/* Reset & Base */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: "Segoe UI", Arial, sans-serif;
  line-height: 1.6;
 
  background-color: #f9f9f9;
  color: #333;
}

/* Header */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #004d40;
  color: #fff;
  padding: 1rem 2rem;
  position: sticky;
  top: 0;
  z-index: 1000;
}

.logo img {
  height: 50px;
  margin-right: 10px;
  vertical-align: middle;
}

.logo h1 {
  font-size: 1.5rem;
  display: inline-block;
}

.navbar ul {
  list-style: none;
  display: flex;
  gap: 1.5rem;
}

.navbar a {
  text-decoration: none;
  color: #fff;
  font-weight: 500;
  transition: color 0.3s ease;
}

.navbar a:hover,
.navbar a.active {
  color: #ffeb3b;
}

.navbar .cta {
  background: #ff5722;
  padding: 0.5rem 1rem;
  border-radius: 5px;
  font-weight: bold;
}

.navbar .cta:hover {
  background: #e64a19;
}

/* Hero Section */
.hero {
  text-align: center;
  padding: 4rem 2rem;
  background: linear-gradient(rgba(0, 77, 64, 0.8), rgba(0, 77, 64, 0.8)),
              url("hero.jpg") center/cover no-repeat;
  color: #fff;
}

.hero h2 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
}

.hero p {
  font-size: 1.2rem;
  margin-bottom: 2rem;
}

.btn-primary,
.btn-secondary {
  display: inline-block;
  margin: 0.5rem;
  padding: 0.75rem 1.5rem;
  border-radius: 5px;
  text-decoration: none;
  font-weight: bold;
  transition: background 0.3s ease;
}

.btn-primary {
  background: #ff5722;
  color: #fff;
}

.btn-primary:hover {
  background: #e64a19;
}

.btn-secondary {
  background: #ffeb3b;
  color: #333;
}

.btn-secondary:hover {
  background: #fbc02d;
}
/* Fade-in animation */
.fade-in {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 1s ease forwards;
}

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Hover pulse for buttons */
.btn-primary, .btn-secondary {
  transition: transform 0.3s ease;
}

.btn-primary:hover, .btn-secondary:hover {
  transform: scale(1.05);
}

/* Gallery zoom */
.gallery-grid img {
  transition: transform 0.4s ease;
}

.gallery-grid img:hover {
  transform: scale(1.1);
}


/* Sections */
section {
  padding: 3rem 2rem;
}

section h2 {
  text-align: center;
  margin-bottom: 1.5rem;
  color: #004d40;
}

/* Projects */
.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
}

.project-grid article {
  background: lightblue;
  padding: 1.5rem;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
}

.project-grid article:hover {
  transform: translateY(-5px);
}

/* Gallery */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
  align-items: center;
}

.gallery-grid img {
  width: 100%;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
}

.gallery-grid img:hover {
  transform: scale(1.05);
}

/* Contact */
.contact p {
  text-align: center;
  margin: 0.5rem 0;
}

.contact a {
  color: #004d40;
  font-weight: bold;
  text-decoration: none;
}

.contact a:hover {
  text-decoration: underline;
}
/* dark mode*/
/* Dark Mode */
body.dark-mode {
  background: black;
  color: #eee;
}

body.dark-mode .header,
body.dark-mode .footer {
  background: #1e1e1e;
}

body.dark-mode a {
  color: #ffeb3b;
}


/* Footer */
.footer {
  background: #004d40;
  color: #fff;
  text-align: center;
  padding: 1.5rem;
}

.footer .social-links {
  margin-top: 1rem;
}

.footer .social-links a {
  margin: 0 0.5rem;
  color: #ffeb3b;
  text-decoration: none;
  transition: color 0.3s ease;
}

.footer .social-links a:hover {
  color: #fff;
}

/* Responsive */
@media (max-width: 768px) {
  .navbar ul {
    flex-direction: column;
    gap: 1rem;
  }

  .hero h2 {
    font-size: 2rem;
  }

  .hero p {
    font-size: 1rem;
  }
}
